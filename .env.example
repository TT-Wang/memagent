# Copy to .env and fill in. .env is gitignored. Repository dotenv is a DATA layer: it may provide
# a model/key and ordinary preferences, but network destinations, proxies/TLS roots, executable extensions,
# sandbox policy, and host-root grants are ignored. Put those in ~/.sliceagent/config.toml or export them in
# the parent shell after reviewing the repository.
LLM_API_KEY=sk-...                       # REQUIRED — any OpenAI-compatible provider (OpenAI/DeepSeek/Moonshot/…)
AGENT_MODEL=gpt-5.5                      # REQUIRED — model id (no default; pick your provider's model)
# LLM_HARD_TIMEOUT_SEC=300               # absolute whole-call watchdog; unset derives from completion budget
# LLM_STREAM_CLOSE_GRACE_SEC=2            # wait to prove a cancelled SSE stream physically closed
# LLM_PROVIDER_MAX_INFLIGHT=4             # physical request cap; timed-out calls hold a slot until closed
# SHOW_SLICE=1                           # print the slice each turn
# back-compat: OPENAI_API_KEY / MOONSHOT_API_KEY are still accepted as key fallbacks

# --- PromptLayer production telemetry (optional; provider key stays local) ---
# PROMPTLAYER_API_KEY=pl_...               # PromptLayer workspace key (secret)
# AGENT_PROMPTLAYER=1                      # explicitly enable background request logging
# AGENT_PROMPTLAYER_CONTENT=metadata       # metadata (safe default) | full (uploads prompt/code/output)
# AGENT_PROMPTLAYER_ENVIRONMENT=development
# AGENT_PROMPTLAYER_TAGS=team:core          # extra comma-separated, low-cardinality tags

# --- memory tier (native typed knowledge is always on; Memem is an optional `memory` install extra) ---
# SLICEAGENT_VAULT=~/.sliceagent/vault    # legacy episodic/task/roster compatibility records
# MEMEM_VAULT=~/obsidian-brain        # memem's human-readable semantic-index projection
# (MEMEM_DIR is memem's own state/db dir, consumed by memem — not a sliceagent knob; see memem docs)

# --- execution / hooks (optional) ---
# AGENT_MINE=off                          # opt-in candidate mining: deterministic | llm | off (default)
# AGENT_SUBAGENT_DEPTH=1                   # max delegation depth (0 disables spawn_subagent)
# AGENT_DELEGATION_TIMEOUT=900             # per-child inactivity window; reset by child/transport activity
# AGENT_DELEGATION_ABSOLUTE=3600           # absolute child leak guard; cannot be disabled
# AGENT_MAX_TOKENS=200000                 # budget ceiling

# --- monitor (optional; AGENT_MONITOR=1 snapshots the live slice for the standing server) ---
# AGENT_MONITOR=1                          # write per-session monitor snapshots
# AGENT_MONITOR_PORT=7654                  # standing server port (first free port at/after it)
# AGENT_MONITOR_TOKEN=                     # pin the monitor's bearer token (else a random one is printed in the URL)
